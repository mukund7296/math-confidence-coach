# Any OpenAI-compatible provider works. Pick ONE block, check the provider's current model list.

# --- Google AI Studio (free tier; NOTE: free-tier prompts may be used by Google to improve products) ---
#LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#LLM_API_KEY=your_key_here
#LLM_MODEL=gemini-3.8-flash


LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_actual_groq_key
LLM_MODEL=openai/gpt-oss-20b
LLM_JSON_MODE=true

CACHE_DB=coach_cache.sqlite3
RATE_LIMIT_PER_HOUR=20

# --- Groq (free tier) ---
# LLM_BASE_URL=https://api.groq.com/openai/v1
# --- OpenRouter (models ending in :free) ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# --- Ollama, fully local, no data leaves your machine ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

LLM_JSON_MODE=true
CACHE_DB=coach_cache.sqlite3
RATE_LIMIT_PER_HOUR=20


